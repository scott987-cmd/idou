import test from "node:test";
import assert from "node:assert/strict";
import { parseDuration } from "../src/duration.js";

test("hours and minutes", () => {
  assert.equal(parseDuration("1h30m"), 5_400_000);
});

test("seconds", () => {
  assert.equal(parseDuration("90s"), 90_000);
});

test("parts separated by spaces", () => {
  assert.equal(parseDuration("2h 5m 10s"), 7_510_000);
});

test("milliseconds", () => {
  assert.equal(parseDuration("250ms"), 250);
});

test("a value that is not a string", () => {
  assert.throws(() => parseDuration(5), TypeError);
});

test("text that is not a duration", () => {
  assert.throws(() => parseDuration("soon"), SyntaxError);
});
