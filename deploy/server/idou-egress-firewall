#!/bin/sh
# The scheduled-task sandbox network (docker network idou-egress, bridge
# idou-egr0) is --internal: no route to the internet. It is not isolated from
# this host, though -- measured 2026-09-22: a container on an internal network
# reached sshd and nginx through the bridge address. So the host answers that
# bridge on exactly one port, the control plane's egress proxy
# (IDOU_SCHEDULED_TASKS_PORT; keep the two equal), and drops everything else,
# IPv6 included (the bridge has a link-local address, and sshd and nginx listen
# on ::). The control plane's own production check cannot see this firewall
# (docs/server-deployment.md §5); keep it with the network it guards.
#
# Installed as /usr/local/sbin/idou-egress-firewall, run by
# idou-egress-firewall.service. A server set up before the product was renamed
# has the network mydoubao-egress on bridge mydoubao-egr0: set BRIDGE to it.
set -eu
BRIDGE=idou-egr0
PORT=8444
CHAIN=IDOU-EGRESS
case "${1:-}" in
  apply)
    iptables -w -N "$CHAIN" 2>/dev/null || true
    iptables -w -F "$CHAIN"
    iptables -w -A "$CHAIN" -p tcp --dport "$PORT" -j ACCEPT
    iptables -w -A "$CHAIN" -j DROP
    iptables -w -C INPUT -i "$BRIDGE" -j "$CHAIN" 2>/dev/null || iptables -w -I INPUT 1 -i "$BRIDGE" -j "$CHAIN"
    ip6tables -w -C INPUT -i "$BRIDGE" -j DROP 2>/dev/null || ip6tables -w -I INPUT 1 -i "$BRIDGE" -j DROP
    ;;
  remove)
    iptables -w -D INPUT -i "$BRIDGE" -j "$CHAIN" 2>/dev/null || true
    iptables -w -F "$CHAIN" 2>/dev/null || true
    iptables -w -X "$CHAIN" 2>/dev/null || true
    ip6tables -w -D INPUT -i "$BRIDGE" -j DROP 2>/dev/null || true
    ;;
  *) echo "usage: $0 apply|remove" >&2; exit 2 ;;
esac
